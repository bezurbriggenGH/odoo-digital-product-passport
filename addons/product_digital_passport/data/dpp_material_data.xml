<?xml version="1.0" encoding="utf-8"?>
<!--
    Starter materials. The emission factors are ILLUSTRATIVE ORDER-OF-MAGNITUDE
    values for learning purposes. Replace them with values from a recognised
    database (ecoinvent, DEFRA/DESNZ, ADEME Base Empreinte...) for real use.
    noupdate="1": once installed, Odoo will not overwrite your edits on upgrade.
-->
<odoo noupdate="1">
    <record id="material_aluminium" model="dpp.material">
        <field name="name">Aluminium</field>
        <field name="code">AL</field>
        <field name="category">metal</field>
        <field name="emission_factor">12.0</field>
        <field name="recycled_emission_factor">0.6</field>
        <field name="source">Illustrative value</field>
    </record>
    <record id="material_steel" model="dpp.material">
        <field name="name">Steel</field>
        <field name="code">ST</field>
