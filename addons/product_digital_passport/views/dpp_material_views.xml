<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dpp_material_view_list" model="ir.ui.view">
        <field name="name">dpp.material.list</field>
        <field name="model">dpp.material</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="emission_factor"/>
                <field name="recycled_emission_factor"/>
                <field name="recyclable"/>
                <field name="hazardous"/>
            </list>
        </field>
    </record>

    <record id="dpp_material_view_form" model="ir.ui.view">
        <field name="name">dpp.material.form</field>
        <field name="model">dpp.material</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Recycled aluminium"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="recyclable"/>
                            <field name="hazardous"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Emission factors">
                            <field name="emission_factor"/>
                            <field name="recycled_emission_factor"/>
                            <field name="source"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dpp_material_view_search" model="ir.ui.view">
        <field name="name">dpp.material.search</field>
        <field name="model">dpp.material</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Recyclable" name="recyclable" domain="[('recyclable', '=', True)]"/>
                <filter string="Hazardous" name="hazardous" domain="[('hazardous', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dpp_material" model="ir.actions.act_window">
        <field name="name">Materials</field>
        <field name="res_model">dpp.material</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first material</p>
            <p>Each material has an emission factor used to compute product footprints.</p>
        </field>
    </record>
</odoo>
